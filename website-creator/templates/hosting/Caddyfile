# Caddy for a static site on an own server: HTTPS and renewal are automatic.
# Replace DOMAIN.TLD (without www). File: /etc/caddy/Caddyfile, then: sudo systemctl reload caddy

www.DOMAIN.TLD {
	redir https://DOMAIN.TLD{uri} permanent
}

DOMAIN.TLD {
	root /var/www/DOMAIN.TLD
	encode
	file_server

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}

	# The ? sets the header only if no rule below set it; without it, it would win
	header ?Cache-Control "no-cache"
	# CSS and JS are versioned by deploy/build.py
	@long path *.woff2 *.woff *.css *.js
	header @long Cache-Control "public, max-age=31536000, immutable"
	@img path *.avif *.webp *.png *.jpg *.jpeg *.gif *.svg *.ico
	header @img Cache-Control "public, max-age=2592000"

	# Hidden files except /.well-known/, and working files
	@hidden {
		path */.* *.md *.py *.zip
		not path /.well-known/*
	}
	respond @hidden 404
}
