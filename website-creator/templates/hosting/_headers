# Response headers for Netlify and Cloudflare (Workers static assets and Pages).
# Ends up in dist/ through HOST_FILES in deploy/build.py.
# Never set Cache-Control on /* as well: Cloudflare joins repeated headers with a comma.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# CSS and JS are versioned by deploy/build.py (?v=...), fonts never change their content
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable
/assets/js/*
  Cache-Control: public, max-age=31536000, immutable

/assets/img/*
  Cache-Control: public, max-age=2592000
